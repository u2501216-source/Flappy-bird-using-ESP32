#include <WiFi.h>
#include <WebServer.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>


#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64

#define OLED_SDA 21
#define OLED_SCL 22

Adafruit_SSD1306 display(
  SCREEN_WIDTH,
  SCREEN_HEIGHT,
  &Wire,
  -1
);


#define FLAP_BUTTON 25
#define RESTART_BUTTON 27
#define LED_PIN 26


const char* WIFI_NAME = "FLAPPY_ESP32";
const char* WIFI_PASSWORD = "12345678";

WebServer server(80);


const int BIRD_X = 25;
const int BIRD_SIZE = 3;

const float GRAVITY = 0.15;
const float FLAP_POWER = -3.2;

const int PIPE_WIDTH = 10;
const int GAP_HEIGHT = 32;

const int PIPE_SPEED = 1;

const int FRAME_DELAY = 45;


float birdY = 32;
float velocity = 0;

int pipeX = 128;
int gapY = 15;

int score = 0;

bool gameOver = false;


unsigned long lastFrame = 0;
unsigned long lastFlap = 0;
unsigned long lastRestart = 0;
unsigned long lastLEDBlink = 0;


bool phoneFlap = false;
bool phoneRestart = false;


void startGame() {

  birdY = 32;
  velocity = 0;

  pipeX = SCREEN_WIDTH + 20;

  gapY = random(7, 25);

  score = 0;

  gameOver = false;

  digitalWrite(LED_PIN, HIGH);

  display.clearDisplay();
  display.display();

  Serial.println("GAME STARTED");
}


void flap() {

  velocity = FLAP_POWER;

  // Small LED flash
  digitalWrite(LED_PIN, LOW);
  delay(15);
  digitalWrite(LED_PIN, HIGH);
}

void drawBird() {

  display.fillCircle(
    BIRD_X,
    (int)birdY,
    BIRD_SIZE,
    SSD1306_WHITE
  );

  // Eye
  display.drawPixel(
    BIRD_X + 1,
    (int)birdY - 1,
    SSD1306_BLACK
  );
}

void drawPipes() {

  int bottomPipe = gapY + GAP_HEIGHT;

  // Top pipe
  display.fillRect(
    pipeX,
    0,
    PIPE_WIDTH,
    gapY,
    SSD1306_WHITE
  );

  // Bottom pipe
  display.fillRect(
    pipeX,
    bottomPipe,
    PIPE_WIDTH,
    SCREEN_HEIGHT - bottomPipe,
    SSD1306_WHITE
  );
}


bool checkCollision() {

  // Ceiling
  if (birdY <= 2) {
    return true;
  }

  // Ground
  if (birdY >= SCREEN_HEIGHT - 2) {
    return true;
  }

  // Pipe collision
  if (
    BIRD_X + 2 >= pipeX &&
    BIRD_X - 2 <= pipeX + PIPE_WIDTH
  ) {

    if (
      birdY <= gapY ||
      birdY >= gapY + GAP_HEIGHT
    ) {

      return true;
    }
  }

  return false;
}


void showGameOver() {

  digitalWrite(LED_PIN, LOW);

  display.clearDisplay();

  display.setTextColor(SSD1306_WHITE);

  display.setTextSize(2);

  display.setCursor(15, 8);
  display.println("GAME");

  display.setCursor(15, 28);
  display.println("OVER");

  display.setTextSize(1);

  display.setCursor(42, 48);
  display.print("SCORE ");
  display.println(score);

  display.setCursor(22, 57);
  display.print("SW2 RESTART");

  display.display();

  Serial.print("GAME OVER - SCORE: ");
  Serial.println(score);
}

