void handlePhoneFlap() {

  phoneFlap = true;

  server.send(
    200,
    "text/plain",
    "FLAP"
  );
}


void handlePhoneRestart() {

  phoneRestart = true;

  server.send(
    200,
    "text/plain",
    "RESTART"
  );
}


void handleScore() {

  server.send(
    200,
    "text/plain",
    String(score)
  );
}

void setup() {

  Serial.begin(115200);


  pinMode(
    FLAP_BUTTON,
    INPUT_PULLUP
  );

  pinMode(
    RESTART_BUTTON,
    INPUT_PULLUP
  );

 
  pinMode(
    LED_PIN,
    OUTPUT
  );

  digitalWrite(
    LED_PIN,
    LOW
  );


  Wire.begin(
    OLED_SDA,
    OLED_SCL
  );

  if (
    !display.begin(
      SSD1306_SWITCHCAPVCC,
      0x3C
    )
  ) {

    Serial.println("OLED NOT FOUND");

    while (true) {
      delay(100);
    }
  }

  display.clearDisplay();

  display.setTextColor(
    SSD1306_WHITE
  );

  randomSeed(
    analogRead(34)
  );


  WiFi.mode(WIFI_AP);

  WiFi.softAP(
    WIFI_NAME,
    WIFI_PASSWORD
  );

  Serial.println();
  Serial.println("======================");
  Serial.println("FLAPPY ESP32");
  Serial.println("======================");

  Serial.print("WiFi: ");
  Serial.println(WIFI_NAME);

  Serial.print("Password: ");
  Serial.println(WIFI_PASSWORD);

  Serial.print("IP Address: ");
  Serial.println(WiFi.softAPIP());

  Serial.println("======================");

  server.on(
    "/",
    handleHome
  );

  server.on(
    "/flap",
    handlePhoneFlap
  );

  server.on(
    "/restart",
    handlePhoneRestart
  );

  server.on(
    "/score",
    handleScore
  );

  server.begin();

  Serial.println(
    "Web server started"
  );

  
  startGame();
}


void loop() {

  server.handleClient();


  if (phoneRestart) {

    phoneRestart = false;

    startGame();
  }


  if (phoneFlap) {

    phoneFlap = false;

    if (!gameOver) {

      flap();
    }
  }


  if (
    digitalRead(
      RESTART_BUTTON
    ) == LOW
  ) {

    if (
      millis() - lastRestart > 250
    ) {

      lastRestart = millis();

      startGame();

      while (
        digitalRead(
          RESTART_BUTTON
        ) == LOW
      ) {

        delay(1);
      }
    }
  }

  if (
    !gameOver &&
    digitalRead(
      FLAP_BUTTON
    ) == LOW
  ) {

    if (
      millis() - lastFlap > 150
    ) {

      lastFlap = millis();

      flap();

      while (
        digitalRead(
          FLAP_BUTTON
        ) == LOW
      ) {

        delay(1);
      }
    }
  }

  if (
    !gameOver &&
    millis() - lastFrame >= FRAME_DELAY
  ) {

    lastFrame = millis();

    // Gravity
    velocity += GRAVITY;

    birdY += velocity;

    // Move pipe
    pipeX -= PIPE_SPEED;


    if (
      pipeX + PIPE_WIDTH < 0
    ) {

      pipeX = SCREEN_WIDTH + 5;

      gapY = random(
        7,
        25
      );

      score++;

      Serial.print("Score: ");
      Serial.println(score);
    }

    if (checkCollision()) {

      gameOver = true;

      showGameOver();

      return;
    }

    display.clearDisplay();

    drawPipes();

    drawBird();

    // Score
    display.setTextSize(1);

    display.setCursor(
      2,
      2
    );

    display.print(
      "SCORE: "
    );

    display.print(
      score
    );

    display.display();
  }

  
  if (gameOver) {

    if (
      millis() - lastLEDBlink >= 400
    ) {

      lastLEDBlink = millis();

      digitalWrite(
        LED_PIN,
        !digitalRead(LED_PIN)
      );
    }
  }
}
